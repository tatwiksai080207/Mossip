# ==============================================================================
# MOSIP Inji Interoperability Playground - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your setup:
#   cp .env.example .env

# --- Application Ports ---
PORT=3001
VITE_PORT=3000
INJI_WEB_PORT=3004

# --- Node Environment ---
NODE_ENV=development
SERVE_STATIC=false

# --- Public Tunnel URL (e.g. from ngrok) for Mobile Wallet testing ---
# Leave empty for local-only testing (http://localhost:3001)
PUBLIC_BASE_URL=

# --- MOSIP Collab Cloud Sandbox Endpoints ---
COLLAB_CERTIFY_URL=https://injicertify-mock.collab.mosip.net
COLLAB_VERIFY_URL=https://injiverify.collab.mosip.net
COLLAB_ESIGNET_URL=https://esignet.collab.mosip.net
COLLAB_ESIGNET_MOCK_URL=https://esignet-mock.collab.mosip.net
COLLAB_MIMOTO_URL=https://api.collab.mosip.net/v1/mimoto

# --- Local Containerized MOSIP Stack (Docker Compose) ---
LOCAL_CERTIFY_URL=http://127.0.0.1:8090/v1/certify
LOCAL_VERIFIER_URL=http://127.0.0.1:8095
LOCAL_MIMOTO_URL=http://127.0.0.1:8099/v1/mimoto

# --- Local PostgreSQL Database (Docker Compose) ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inji_mimoto

# --- Security, Key Seeds & Service Credentials ---
CERTIFY_KEY_SEED=mossip-certify-ed25519-seed-32b!
OIDC_KEYSTORE_PASSWORD=xy4gh6swa2i
WALLET_BINDING_PARTNER_API_KEY=dummywalletbindingpartnerapikey
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- External Reference Implementations ---
WALTID_ISSUER_ENABLED=true
WALTID_VERIFIER_ENABLED=true
