# ==============================================================================
# MOSIP Inji Interoperability Playground - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local or cloud setup:
#   cp .env.example .env

# --- BFF Server Configuration ---
PORT=3001
NODE_ENV=development
SERVE_STATIC=false
# Optional explicit public tunnel URL (e.g. from ngrok) for mobile wallet testing
# PUBLIC_BASE_URL=https://<your-subdomain>.ngrok-free.dev

# --- MOSIP Collab Cloud Sandbox Endpoints ---
COLLAB_CERTIFY_URL=https://injicertify-mock.collab.mosip.net
COLLAB_VERIFY_URL=https://injiverify.collab.mosip.net
COLLAB_ESIGNET_URL=https://esignet.collab.mosip.net
COLLAB_ESIGNET_MOCK_URL=https://esignet-mock.collab.mosip.net
COLLAB_MIMOTO_URL=https://api.collab.mosip.net/v1/mimoto

# --- Local Containerized MOSIP Stack (Docker Compose) ---
LOCAL_CERTIFY_URL=http://127.0.0.1:8090/v1/certify
LOCAL_VERIFIER_URL=http://127.0.0.1:8095
LOCAL_MIMOTO_URL=http://127.0.0.1:8099/v1/mimoto

# --- Local Mimoto PostgreSQL Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inji_mimoto

# --- External Reference Implementations ---
WALTID_ISSUER_ENABLED=true
WALTID_VERIFIER_ENABLED=true
