{
  "name": "inji-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "docker:stack": "docker compose --env-file .env -f mosip-stack/docker-compose.yaml up -d",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "test:all": "npm run typecheck && npm run test && npm run check:suite",
    "check:suite": "tsx scripts/check-suite.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@digitalbazaar/did-method-key": "^5.2.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.1.0",
    "@digitalbazaar/vc": "^7.1.2",
    "@mosip/react-inji-verify-sdk": "^0.17.0-beta.13",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "jsonld": "^8.3.2",
    "jsqr": "^1.4.0",
    "mermaid": "^11.17.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
